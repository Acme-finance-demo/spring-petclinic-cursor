{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "labels": ["dependencies", "renovate"],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    }
  ],
  "prConcurrentLimit": 5
}